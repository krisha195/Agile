# ==========================================
# GearGuard Environment Variables (Template)
# Copy this file to .env in local development.
# NEVER commit real credentials, tokens, or database URIs.
# ==========================================

# Backend Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Configuration
# In production with unified hosting, leave empty to use same origin.
# In decoupled local dev, point to Express backend server.
REACT_APP_API_URL=http://localhost:5000
